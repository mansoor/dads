# Build context is the repo root (see dads/docker-compose.yml).
# Keep: scripts/, templates/, init_workspace.sh, dads/frontend, dads/backend.

.git
.gitattributes
.gitignore
**/.DS_Store

# Frontend build artifacts / deps (rebuilt inside the image)
dads/frontend/node_modules
dads/frontend/.vite-cache
dads/backend/cmd/server/dist

# Runtime data — bind-mounted at runtime, not baked into the image
workspaces

# Local env / secrets
dads/.env
.env

# Docs and scratch
*.md
DADS_*.md
_wsverify
